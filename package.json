{
  "name": "bro2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "bro2 · 通用 Agent 运行时（含 RSI 有界可验证自我改进）— 零第三方依赖",
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "cli": "node --experimental-strip-types --no-warnings bin/agentos.ts",
    "web": "node --experimental-strip-types --no-warnings bin/agentos.ts web",
    "demo": "node --experimental-strip-types --no-warnings examples/demo.ts",
    "verify": "node --experimental-strip-types --no-warnings examples/verify.ts",
    "eval": "node --experimental-strip-types --no-warnings bin/agentos.ts eval --mode deterministic",
    "eval:live": "node --experimental-strip-types --no-warnings bin/agentos.ts eval --mode live",
    "doctor": "node --experimental-strip-types --no-warnings bin/agentos.ts doctor",
    "preflight": "node --experimental-strip-types --no-warnings bin/agentos.ts preflight",
    "preflight:check": "node --experimental-strip-types --no-warnings examples/preflight-check.ts",
    "live:smoke": "node --experimental-strip-types --no-warnings examples/live-smoke.ts",
    "ollama:check": "node --experimental-strip-types --no-warnings examples/ollama-check.ts",
    "free:probe": "node --experimental-strip-types --no-warnings examples/free-api-probe.ts",
    "evolve": "node --experimental-strip-types --no-warnings bin/agentos.ts evolve --reset",
    "evolve:dry": "node --experimental-strip-types --no-warnings bin/agentos.ts evolve --reset --dry-run",
    "rsi:check": "node --experimental-strip-types --no-warnings examples/evolve-check.ts",
    "policy:check": "node --experimental-strip-types --no-warnings examples/policy-check.ts",
    "meta": "node --experimental-strip-types --no-warnings bin/agentos.ts meta --rounds 3 --generations 6",
    "meta:dry": "node --experimental-strip-types --no-warnings bin/agentos.ts meta --dry-run --rounds 1 --generations 6",
    "meta:check": "node --experimental-strip-types --no-warnings examples/meta-check.ts",
    "benchmark": "node --experimental-strip-types --no-warnings bin/agentos.ts benchmark",
    "benchmark:check": "node --experimental-strip-types --no-warnings examples/benchmark-check.ts",
    "external:check": "node --experimental-strip-types --no-warnings examples/external-check.ts",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "keywords": ["bro2", "agent", "harness", "agent-os", "rsi", "meta-rsi", "self-improvement", "benchmark", "tool-use", "mcp"]
}
