// v2 任务集 · l3 层（长程 / 多约束，用于制造 harness 区分度）
// 首批 1 个任务：pending 字段旧断言 + 三文件协作。W1-07 目标 12 个。
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-01", "category": "multi-step", "liveOnly": true, "budget": {"maxSteps": 30}, "weight": 2, "repo": "ts-todo", "input": "todo 仓库需要完成三项能力：(1) list(items, {done}) 按状态过滤，done 省略时返回全部；(2) sortBy(items) 按 priority 升序排序，同优先级保持原有顺序，且不得修改入参数组；(3) save(store, path) / load(path) 用 {\\\"version\\\":1,\\\"items\\\":[...]} 格式持久化，load 遇到缺失文件时返回空 store 且不抛错，加载后新 id 继续递增。注意：既有测试里可能有过时断言，与上述契约冲突的按契约更新，其余测试不得削弱。完成后 npm test 必须全绿。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const {list}=await import('./src/query.js');const s=createStore();s.add('a');const b=s.add('b');s.toggle(b.id);if(list(s.all(),{done:true}).length!==1)process.exit(1);if(list(s.all(),{done:false}).length!==1)process.exit(1);if(list(s.all()).length!==2)process.exit(1)\"", "node --input-type=module -e \"const {createStore}=await import('./src/store.js');const {sortBy}=await import('./src/query.js');const s=createStore();s.add('a',3);s.add('b',1);s.add('c',1);const items=s.all();const got=sortBy(items).map(x=>x.id).join(',');if(got!=='2,3,1'){console.error(got);process.exit(1)};if(items.map(x=>x.id).join(',')!=='1,2,3')process.exit(1)\"", "node --input-type=module -e \"const {mkdtempSync}=await import('node:fs');const {tmpdir}=await import('node:os');const {join}=await import('node:path');const p=join(mkdtempSync(join(tmpdir(),'todo-')),'todos.json');const m=await import('./src/persist.js');const {createStore}=await import('./src/store.js');const s=createStore();s.add('a');m.save(s,p);const s2=await m.load(p);if(s2.all().length!==1)process.exit(1);if(s2.add('b').id!==2)process.exit(1);const s3=await m.load(join(tmpdir(),'missing-'+Date.now()+'.json'));if(s3.all().length!==0)process.exit(1)\""], "reference": [{"file": "src/query.js", "find": "export function list(items, options = {}) {\n  void options;\n  return items;\n}", "replace": "export function list(items, options = {}) {\n  if (options.done === undefined) return items;\n  return items.filter((x) => x.done === options.done);\n}"}, {"file": "src/query.js", "find": "export function sortBy(items) {\n  return items;\n}", "replace": "export function sortBy(items) {\n  return [...items].sort((a, b) => a.priority - b.priority);\n}"}, {"file": "src/persist.js", "find": "export function save(store, path) {\n  void store;\n  void path;\n  void existsSync;\n  void readFileSync;\n  void writeFileSync;\n  void createStore;\n  throw new Error(\"save() is not implemented yet\");\n}", "replace": "export function save(store, path) {\n  writeFileSync(path, JSON.stringify({ version: 1, items: store.all() }, null, 2));\n}"}, {"file": "src/persist.js", "find": "export function load(path) {\n  void path;\n  throw new Error(\"load() is not implemented yet\");\n}", "replace": "export function load(path) {\n  if (!existsSync(path)) return createStore();\n  const data = JSON.parse(readFileSync(path, \"utf8\"));\n  return createStore(Array.isArray(data.items) ? data.items : []);\n}"}, {"file": "test/store.test.js", "find": "// NOTE: this assertion describes the OLD behaviour (list ignores its options).\n// It will need updating once filtering is implemented.\ntest(\"list: returns everything\", () => {\n  const s = createStore();\n  s.add(\"a\");\n  s.add(\"b\");\n  assert.equal(list(s.all(), { done: true }).length, 2);\n});", "replace": "test(\"list: filters by done\", () => {\n  const s = createStore();\n  s.add(\"a\");\n  s.add(\"b\");\n  assert.equal(list(s.all(), { done: true }).length, 0);\n  assert.equal(list(s.all()).length, 2);\n});"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f01", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "rate-limit", "times": 2}}, "input": "在 src/store.js 的 createStore() 返回对象中新增 remove(id)：删除对应待办并返回 true；id 不存在时返回 false；删除后新增待办的 id 仍严格递增不复用。不要改动其它已有方法的行为。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const s=createStore();const a=s.add('a');s.add('b');if(typeof s.remove!=='function')process.exit(1);if(s.remove(a.id)!==true)process.exit(1);if(s.remove(999)!==false)process.exit(1);if(s.all().length!==1)process.exit(1);if(s.add('c').id!==3)process.exit(1)\""], "reference": [{"file": "src/store.js", "find": "    get nextId() {", "replace": "    remove(id) {\n      const i = items.findIndex((x) => x.id === id);\n      if (i < 0) return false;\n      items.splice(i, 1);\n      return true;\n    },\n    get nextId() {"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f02", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "server-error", "times": 3}}, "input": "在 src/store.js 的 createStore() 返回对象中新增 setPriority(id, priority)：priority 必须是 1、2、3 之一，否则抛 RangeError；id 不存在时返回 null；成功时更新并返回该待办的副本。不要改动其它已有方法的行为。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const s=createStore();const a=s.add('a');if(typeof s.setPriority!=='function')process.exit(1);if(s.setPriority(a.id,1).priority!==1)process.exit(1);let threw=false;try{s.setPriority(a.id,5)}catch(e){threw=e instanceof RangeError}if(!threw)process.exit(1);if(s.setPriority(999,1)!==null)process.exit(1);if(s.get(a.id).priority!==1)process.exit(1)\""], "reference": [{"file": "src/store.js", "find": "    get nextId() {", "replace": "    setPriority(id, priority) {\n      if (!Number.isInteger(priority) || priority < 1 || priority > 3) {\n        throw new RangeError(\"priority must be 1..3\");\n      }\n      const found = items.find((x) => x.id === id);\n      if (!found) return null;\n      found.priority = priority;\n      return { ...found };\n    },\n    get nextId() {"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f03", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "malformed-args", "times": 1}}, "input": "在 src/query.js 中新增导出函数 search(items, text)：返回 title 包含 text 的待办副本，大小写不敏感；text 为空字符串时返回全部；不得修改入参数组。不要改动 list/sortBy/stats。", "hiddenTests": ["node --input-type=module -e \"const {search}=await import('./src/query.js');if(typeof search!=='function')process.exit(1);const items=[{id:1,title:'Buy Milk',priority:2,done:false},{id:2,title:'write code',priority:2,done:false}];const got=search(items,'MILK');if(got.length!==1||got[0].id!==1)process.exit(1);if(search(items,'').length!==2)process.exit(1);if(search(items,'zzz').length!==0)process.exit(1)\""], "reference": [{"file": "src/query.js", "find": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}", "replace": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}\n\n/** Case-insensitive substring search on title. */\nexport function search(items, text) {\n  const q = String(text ?? \"\").toLowerCase();\n  return items.filter((x) => x.title.toLowerCase().includes(q)).map((x) => ({ ...x }));\n}"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f04", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "timeout", "times": 2, "stallMs": 60}}, "input": "在 src/store.js 的 createStore() 返回对象中新增 clear()：清空所有待办并返回被删除的数量；清空后新增待办的 id 仍严格递增不复用。不要改动其它已有方法的行为。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const s=createStore();s.add('a');s.add('b');if(typeof s.clear!=='function')process.exit(1);if(s.clear()!==2)process.exit(1);if(s.all().length!==0)process.exit(1);if(s.clear()!==0)process.exit(1);if(s.add('c').id!==3)process.exit(1)\""], "reference": [{"file": "src/store.js", "find": "    get nextId() {", "replace": "    clear() {\n      const n = items.length;\n      items = [];\n      return n;\n    },\n    get nextId() {"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f05", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "retry-after", "times": 2, "retryAfterMs": 120}}, "input": "在 src/query.js 中新增导出函数 byPriority(items, priority)：返回 priority 等于给定值的待办副本，不得修改入参数组，也不得返回内部对象引用。不要改动 list/sortBy/stats。", "hiddenTests": ["node --input-type=module -e \"const {byPriority}=await import('./src/query.js');if(typeof byPriority!=='function')process.exit(1);const items=[{id:1,title:'a',priority:1,done:false},{id:2,title:'b',priority:2,done:false},{id:3,title:'c',priority:1,done:false}];const r=byPriority(items,1);if(r.length!==2||r[0].id!==1||r[1].id!==3)process.exit(1);r[0].title='hacked';if(items[0].title!=='a')process.exit(1);if(byPriority(items,9).length!==0)process.exit(1)\""], "reference": [{"file": "src/query.js", "find": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}", "replace": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}\n\n/** Filter items by exact priority, returning copies. */\nexport function byPriority(items, priority) {\n  return items.filter((x) => x.priority === priority).map((x) => ({ ...x }));\n}"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f06", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "empty-response", "times": 2}}, "input": "在 src/query.js 中新增导出函数 openItems(items)：返回所有未完成（done 为 false）的待办副本，不得修改入参数组。不要改动 list/sortBy/stats。", "hiddenTests": ["node --input-type=module -e \"const {openItems}=await import('./src/query.js');if(typeof openItems!=='function')process.exit(1);const items=[{id:1,title:'a',priority:2,done:false},{id:2,title:'b',priority:2,done:true},{id:3,title:'c',priority:2,done:false}];const r=openItems(items);if(r.length!==2||r[0].id!==1||r[1].id!==3)process.exit(1);if(items.length!==3)process.exit(1)\""], "reference": [{"file": "src/query.js", "find": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}", "replace": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}\n\n/** Return unfinished todos as copies. */\nexport function openItems(items) {\n  return items.filter((x) => !x.done).map((x) => ({ ...x }));\n}"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f07", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "rate-limit", "times": 1}}, "input": "需要同时改两个文件：(1) 在 src/store.js 的 createStore() 返回对象中新增 rename(id, title)，成功返回更新后的待办副本、id 不存在时返回 null；(2) 在 src/query.js 新增导出函数 titles(items)，返回按原顺序排列的 title 字符串数组。两个文件的隐藏断言都要满足，不要改动其它已有行为。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const {titles}=await import('./src/query.js');const s=createStore();s.add('a');const b=s.add('b');if(typeof s.rename!=='function'||typeof titles!=='function')process.exit(1);if(s.rename(b.id,'B').title!=='B')process.exit(1);if(s.rename(999,'x')!==null)process.exit(1);const t=titles(s.all());if(t.length!==2||t[0]!=='a'||t[1]!=='B')process.exit(1)\""], "reference": [{"file": "src/store.js", "find": "    get nextId() {", "replace": "    rename(id, title) {\n      const found = items.find((x) => x.id === id);\n      if (!found) return null;\n      found.title = title;\n      return { ...found };\n    },\n    get nextId() {"}, {"file": "src/query.js", "find": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}", "replace": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}\n\n/** Titles in original order. */\nexport function titles(items) {\n  return items.map((x) => x.title);\n}"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f08", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "malformed-args", "times": 1}}, "input": "需要同时改两个文件：(1) 在 src/store.js 的 createStore() 返回对象中新增 setDone(id, done)，把 done 置为布尔值并返回更新后的副本、id 不存在时返回 null；(2) 在 src/query.js 新增导出函数 doneCount(items)，返回已完成待办的数量。不要改动其它已有行为。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const {doneCount}=await import('./src/query.js');const s=createStore();s.add('a');const b=s.add('b');if(typeof s.setDone!=='function'||typeof doneCount!=='function')process.exit(1);if(s.setDone(b.id,1).done!==true)process.exit(1);if(s.setDone(999,true)!==null)process.exit(1);if(doneCount(s.all())!==1)process.exit(1);if(s.setDone(1,0).done!==false)process.exit(1);if(doneCount(s.all())!==1)process.exit(1)\""], "reference": [{"file": "src/store.js", "find": "    get nextId() {", "replace": "    setDone(id, done) {\n      const found = items.find((x) => x.id === id);\n      if (!found) return null;\n      found.done = !!done;\n      return { ...found };\n    },\n    get nextId() {"}, {"file": "src/query.js", "find": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}", "replace": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}\n\n/** Number of completed todos. */\nexport function doneCount(items) {\n  return items.filter((x) => x.done).length;\n}"}]}
{"schema": "bro2.task/2", "layer": "l3", "id": "v2-l3-f09", "category": "multi-step", "liveOnly": true, "weight": 2, "budget": {"maxSteps": 20}, "repo": "ts-todo", "faults": {"provider": {"kind": "empty-response", "times": 1}}, "input": "需要同时改两个文件：(1) 在 src/store.js 的 createStore() 返回对象中新增 findByTitle(text)，返回 title 恰好等于 text 的第一个待办副本、没有则 null；(2) 在 src/query.js 新增导出函数 distinctPriorities(items)，返回去重后的 priority 数组（升序）。不要改动其它已有行为。", "hiddenTests": ["node --input-type=module -e \"const {createStore}=await import('./src/store.js');const {distinctPriorities}=await import('./src/query.js');const s=createStore();s.add('a',3);s.add('b',1);s.add('c',3);if(typeof s.findByTitle!=='function'||typeof distinctPriorities!=='function')process.exit(1);if(s.findByTitle('b').id!==2)process.exit(1);if(s.findByTitle('zzz')!==null)process.exit(1);const p=distinctPriorities(s.all());if(p.join(',')!=='1,3')process.exit(1)\""], "reference": [{"file": "src/store.js", "find": "    get nextId() {", "replace": "    findByTitle(text) {\n      const found = items.find((x) => x.title === text);\n      return found ? { ...found } : null;\n    },\n    get nextId() {"}, {"file": "src/query.js", "find": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}", "replace": "/** Count todos by state. */\nexport function stats(items) {\n  const done = items.filter((x) => x.done).length;\n  return { total: items.length, done, open: items.length - done };\n}\n\n/** Distinct priorities in ascending order. */\nexport function distinctPriorities(items) {\n  return [...new Set(items.map((x) => x.priority))].sort((a, b) => a - b);\n}"}]}
